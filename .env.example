# Copy to .env for local development. Never commit .env.
# ---- core
SECRET_KEY=change-me-to-a-long-random-string     # required when DEBUG=0
DEBUG=1                                          # 0 in production
DATABASE_URL=postgres://audix:audix@localhost:5432/audix
TIME_ZONE=Asia/Kolkata
# ALLOWED_HOSTS=vault.example.com                # comma separated; RAILWAY_PUBLIC_DOMAIN is added automatically
# CSRF_TRUSTED_ORIGINS=https://vault.example.com # comma separated
# PORTAL_BASE_URL=https://vault.example.com      # used in email links

# ---- first admin (created on start if no admin exists)
ADMIN_LOGIN_ID=admin
ADMIN_INITIAL_PASSWORD=change-me-temporary-password
# ADMIN_NAME=Audix Admin
# ADMIN_EMAIL=owner@example.com
# ADMIN_FORCE_PASSWORD_CHANGE=1                  # 0 skips the forced change at first login

# ---- demo data (seed_demo runs only when DEBUG=1 or ALLOW_DEMO_SEED=1)
ALLOW_DEMO_SEED=1
DEMO_CLIENT_PASSWORD=change-me-demo-client-password
# DEMO_AUDITOR_PASSWORD=change-me-demo-auditor-password

# ---- private file storage (S3-compatible: Railway Bucket, Cloudflare R2, AWS S3)
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # empty for AWS S3
# S3_BUCKET_NAME=audix-vault-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# SIGNED_URL_MINUTES=10
ALLOW_LOCAL_STORAGE=1                            # development only: files on local disk

# ---- email (SMTP URL, e.g. smtp+tls://user:password@smtp.example.com:587). Console output if empty.
# EMAIL_URL=
# DEFAULT_FROM_EMAIL=Audix Vault <no-reply@example.com>

# ---- monitoring
# SENTRY_DSN=

# ---- backups (backup_database / sync_bucket_backup)
# BACKUP_S3_ENDPOINT_URL=
# BACKUP_S3_BUCKET_NAME=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=
